{
  "name": "@stellar-aid/sdk",
  "version": "0.1.0-testnet",
  "contractsRelease": "v0.1.0-testnet",
  "description": "TypeScript SDK for StellarAid: claimable-balance giveaways, SEP-10 auth, generated contract bindings, and shared types.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./giveaways": {
      "import": {
        "types": "./dist/giveaways.d.ts",
        "default": "./dist/giveaways.js"
      },
      "require": {
        "types": "./dist/giveaways.d.cts",
        "default": "./dist/giveaways.cjs"
      }
    },
    "./auth": {
      "import": {
        "types": "./dist/auth.d.ts",
        "default": "./dist/auth.js"
      },
      "require": {
        "types": "./dist/auth.d.cts",
        "default": "./dist/auth.cjs"
      }
    },
    "./events": {
      "import": {
        "types": "./dist/events.d.ts",
        "default": "./dist/events.js"
      },
      "require": {
        "types": "./dist/events.d.cts",
        "default": "./dist/events.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && vitest run",
    "test:integration": "vitest run test/help-requests-lifecycle.test.ts",
    "test:watch": "vitest",
    "test:coverage": "pnpm build && vitest run --coverage",
    "docs": "typedoc",
    "sync:bindings": "tsx scripts/sync-bindings.ts",
    "sync:deployments": "tsx scripts/sync-deployments.ts",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": "^13.0.0 || ^14.0.0 || ^17.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.12.0",
    "@stellar/stellar-sdk": "^13.0.0",
    "@types/node": "^20.16.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.1",
    "typedoc": "^0.26.10",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
